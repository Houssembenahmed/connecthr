                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="664.0" spacing="20.0">
                            <children>
                                <Button fx:id="AjouterMouvementBtn" mnemonicParsing="false" onAction="#AjouterMouvement" prefHeight="45.0" prefWidth="170.0" styleClass="action-button" text="Ajouter mouvement" />
                                <Button fx:id="retourBtn" mnemonicParsing="false" onAction="#retourMain" prefHeight="45.0" prefWidth="170.0" styleClass="action-button" text="Retour" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>