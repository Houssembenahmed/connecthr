                                <TextField fx:id="quantiteMouvementInput" prefHeight="45.0" prefWidth="200.0" promptText="Quantité du mouvement" />
                            </children>
                        </HBox>
                        <HBox prefHeight="91.0" prefWidth="664.0" spacing="10.0">
                            <children>
                                <Label alignment="CENTER" prefHeight="45.0" prefWidth="170.0" text="Date:">
                                    <font>
